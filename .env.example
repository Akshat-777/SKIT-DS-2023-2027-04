# Select default provider for python -m market.collect
JOB_BOARD_SOURCE=mock

# Optional Adzuna provider
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Optional JSearch / RapidAPI provider
JSEARCH_API_KEY=

# Optional authorized LinkedIn data provider endpoint; direct scraping is not used
LINKEDIN_JOBS_ENDPOINT=
LINKEDIN_API_KEY=

# Optional PostgreSQL connection, used by market.load_postgres
DATABASE_URL=postgresql://careerlens:change-me@localhost:5432/careerlens

LOG_LEVEL=INFO

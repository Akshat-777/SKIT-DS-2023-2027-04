# CareerLens Environment Configuration
# API Gateway for Python FastAPI (Resume parsing, ATS scoring, Market-Fit, Roadmap, Critique)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Auth Service for Node.js + Express (JWT issuance, registration, token verification)
VITE_AUTH_BASE_URL=http://localhost:5000/api/auth

# Mock Data Flag (true enables local offline prototype without requiring backend services)
VITE_USE_MOCK=true
